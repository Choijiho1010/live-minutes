# live-minutes 환경설정 예시. 복사해서 쓴다: cp .env.example .env
# .env 는 커밋되지 않는다 (.gitignore).

# --- Hugging Face (화자분리 모델 다운로드용) ---
# 토큰 원문을 여기 적지 마라. 파일 경로만 가리킨다.
HF_TOKEN_FILE=/Volumes/T7/ai-cache/.hf_token
# 모델 캐시 위치. 내장 SSD 여유가 빠듯해 외장으로 뺀다.
HF_HOME=/Volumes/T7/ai-cache/hf

# --- 포트 (8501 은 다른 앱이 점유 중) ---
LM_API_HOST=127.0.0.1
LM_API_PORT=8000
LM_UI_PORT=8502

# --- 저장 경로 ---
LM_T7_ROOT=/Volumes/T7
LM_DATA_DIR=/Volumes/T7/live-minutes/data
